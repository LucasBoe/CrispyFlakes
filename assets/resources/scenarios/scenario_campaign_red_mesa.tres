[resource]
script = ExtResource("1_script")
scenario_id = "scenario_campaign_red_mesa"
display_name = "Red Mesa"
description = "Gold has been discovered in Red Mesa, drawing prospectors and investors alike.
Some emerge from the mines caked in dirt, others seek culture and opportunity.
Can you satisfy both?"
difficulty = 3.5
starting_money = 30
use_default_starting_layout = true
starting_bounty_count = 1
starting_worker_count = 1
starting_guest_count = 0
use_default_unlocks = true
feature_overrides = {
0: true,
2: true,
3: true,
4: false
}
robber_spawn_chance = 0.1
guest_spawn_base_rate = 2.0
is_campaign = true
